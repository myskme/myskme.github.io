+// MYSKME: match upstream NNEvaluator's perspective and score postprocessing.
+// The fixed ABI returns white win/loss logits, no-result disabled under area/PSK,
+// and white score/lead in points (not the raw network's 1/20 point units).
+static void copyWhiteValues(const NNOutput& out, Player pla, float* dst) {
+  const auto& pp = NeuralNet::getModelDesc(gModel).postProcessParams;
+  const float sign = pla == P_WHITE ? 1.0f : -1.0f;
+  dst[0] = (pla == P_WHITE ? out.whiteWinProb : out.whiteLossProb) * pp.outputScaleMultiplier;
+  dst[1] = (pla == P_WHITE ? out.whiteLossProb : out.whiteWinProb) * pp.outputScaleMultiplier;
+  dst[2] = -100000.0f;
+  dst[3] = sign * out.whiteScoreMean * pp.outputScaleMultiplier * pp.scoreMeanMultiplier;
+  dst[4] = sign * out.whiteLead * pp.outputScaleMultiplier * pp.leadMultiplier;
+}
